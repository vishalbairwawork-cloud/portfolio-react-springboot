{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Vishal Bairwa Portfolio - React + Java Spring Boot Monorepo",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && ./mvnw clean package -DskipTests",
    "build:all": "npm run build:frontend && npm run build:backend",
    "test:backend": "cd backend && ./mvnw test"
  },
  "keywords": [
    "react",
    "spring-boot",
    "portfolio",
    "monorepo",
    "tailwindcss",
    "framer-motion",
    "h2-database"
  ],
  "author": "Vishal Bairwa",
  "license": "MIT",
  "devDependencies": {
    "vercel": "^65.0.0"
  }
}
